{
  "name": "cyber-divination",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:skill": "node scripts/sync-bazi-skill.mjs",
