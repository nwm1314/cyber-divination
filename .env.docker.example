# 仅供本地 Docker Compose。复制为 .env.docker；不要提交 .env.docker。
APP_PORT=3000

# Compose 本地数据库。生产必须替换为强密码或外部托管 Postgres。
POSTGRES_USER=cyber
POSTGRES_PASSWORD=cyber
POSTGRES_DB=cyber_divination
DATABASE_URL=postgres://cyber:cyber@db:5432/cyber_divination
CLOUD_STORE_DRIVER=postgres

# 本地 Compose 使用开发登录。生产必须关闭 AUTH_ALLOW_DEV_LOGIN，并配置 Magic Link。
AUTH_SECRET=local-compose-auth-secret-change-before-production
AUTH_URL=http://localhost:3000
AUTH_METHOD=credentials
AUTH_ALLOW_DEV_LOGIN=1

# 本地单实例默认。生产多实例必须改用 Upstash/Redis。
SHARE_STORE_DRIVER=local
RATE_LIMIT_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SHARE_TTL_SECONDS=2592000

# 可选 LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
