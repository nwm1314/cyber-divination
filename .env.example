# 完整部署说明见 docs/DEPLOY.md
# 复制本文件为 .env.local（本地）或写入托管平台 Environment Variables（生产）
# 切勿将真实密钥提交仓库

# —— LLM（服务端 only，勿用 NEXT_PUBLIC_ 前缀）——
# OpenAI 兼容 Chat Completions。
# 排盘/装卦：确定性引擎，零 LLM。
# 解读/解卦：默认可选「模板」；配置 Key 后报告页才可切「LLM」。
# 未配置 LLM_API_KEY 时：报告页 LLM 按钮禁用，并提示配置本文件（不再可点后回落）。
# 探测接口：GET /api/reading/status → { data: { llmConfigured: boolean } }（不暴露 Key）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# —— 分享存储（T70）——
# SHARE_STORE_DRIVER=local|upstash
#   local（默认）：开发用，写入 data/shares.json（无持久磁盘的 Serverless 不可靠）
#   upstash：生产推荐，需下方 Upstash REST 凭证；缺配置会 fail-fast，不会静默回落本地文件
SHARE_STORE_DRIVER=local

# Upstash Redis REST（SHARE_STORE_DRIVER=upstash 时必填）
# 控制台 → Database → REST API；Key 前缀为 share:{token}
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 可选：分享快照 TTL（秒）。仅 upstash 生效；不设或 0 表示不过期
# 生产示例 30 天：SHARE_TTL_SECONDS=2592000
# SHARE_TTL_SECONDS=2592000

# —— API 限流（T71 / T210）——
# 客户端键：x-forwarded-for / x-real-ip；超限 HTTP 429
# RATE_LIMIT_DRIVER=memory|redis（默认 memory）
#   memory：单进程固定窗口；Serverless 多实例不共享
#   redis：Upstash 固定窗口，key=rl:{bucket}:{clientKey}；与分享共用 UPSTASH_* 凭证
#          缺 URL/TOKEN 时 fail-fast，禁止静默回落 memory
# RATE_LIMIT_DRIVER=memory
# RATE_LIMIT_READING_MAX=15
# RATE_LIMIT_READING_WINDOW_MS=60000
# RATE_LIMIT_SHARE_MAX=30
# RATE_LIMIT_SHARE_WINDOW_MS=60000

# —— 账号会话（T81 / T222）——
# 签名会话 Cookie（cyber_session）的 HMAC 密钥；生产必填，开发未设则用内置占位
# 生成示例：openssl rand -base64 32
AUTH_SECRET=

# 站点公网 URL（Magic Link 回调拼接用）
# AUTH_URL=https://your-domain.example
# AUTH_URL=http://localhost:3000

# 登录方式：不设则开发可用 Credentials 快速登录，生产默认 Magic Link
# AUTH_METHOD=magic|credentials
# 生产强制允许开发假登录（不推荐）：AUTH_ALLOW_DEV_LOGIN=1

# Magic Link 发信（可选；未配置时开发环境返回 devLink）
# AUTH_EMAIL_FROM=noreply@your-domain.example
# RESEND_API_KEY=

# —— Postgres 云端档案（T220–T223）——
# 有 DATABASE_URL 时用户/八字/紫微/六爻/Person 走 Postgres；否则 data/*.json
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# 强制驱动：CLOUD_STORE_DRIVER=file|postgres（postgres 时 DATABASE_URL 必填）
# CLOUD_STORE_DRIVER=
# 生产部署前：npm run db:migrate；可选跳过请求路径建表：
# DB_SKIP_ENSURE_SCHEMA=1

# —— Docker / 生产安全提示 ——
# 本地 Compose 配置请复制 .env.docker.example 为 .env.docker。
# 生产不得使用示例 AUTH_SECRET、AUTH_ALLOW_DEV_LOGIN=1、file 云存储或 memory 多实例限流。
# 探活：GET /api/health（liveness）；GET /api/health/ready（readiness）
# 部署前：NODE_ENV=production npm run check:prod-env
